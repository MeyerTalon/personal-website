# ======================
# Environment Variables
# ======================
# Copy this file to .env and fill in the values

# Vercel (for CI/CD deployment)
VERCEL_TOKEN=your_vercel_token_here
VERCEL_ORG_ID=your_org_id_here
VERCEL_PROJECT_ID=your_project_id_here

# Contact form (Resend)
# Get your API key at https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxx
# Optional: where to receive contact form emails (default: talon_meyer@berkeley.edu)
CONTACT_EMAIL=talon_meyer@berkeley.edu
# Optional: "from" address (must be a verified domain in Resend, or use onboarding@resend.dev for testing)
RESEND_FROM=Portfolio <onboarding@resend.dev>

# Analytics (optional)
VITE_GA_TRACKING_ID=G-XXXXXXXXXX
