# ======================
# Environment Variables
# ======================
# Copy this file to .env and fill in the values

# Vercel (for CI/CD deployment)
VERCEL_TOKEN=your_vercel_token_here
VERCEL_ORG_ID=your_org_id_here
VERCEL_PROJECT_ID=your_project_id_here

# Contact form (Resend)
# Get your API key at https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxx
# Where to receive contact form emails.
# If using RESEND_FROM=onboarding@resend.dev (unverified), Resend only allows sending to the email
# on your Resend account — set CONTACT_EMAIL to that address (e.g. your@gmail.com).
# After verifying a domain at https://resend.com/domains you can use any CONTACT_EMAIL.
CONTACT_EMAIL=your-resend-account-email@gmail.com
# "from" address: use onboarding@resend.dev for testing (sends only to your Resend account email),
# or use a verified domain e.g. Portfolio <contact@yourdomain.com>
RESEND_FROM=Portfolio <onboarding@resend.dev>

# Analytics (optional)
VITE_GA_TRACKING_ID=G-XXXXXXXXXX
